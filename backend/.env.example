# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection (supports MONGO_URI or MONGODB_URI on Vercel)
# For local MongoDB: mongodb://localhost:27017/optivus
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/optivus
MONGO_URI=mongodb://localhost:27017/optivus
MONGODB_URI=mongodb://localhost:27017/optivus

# JWT Secrets
# Generate strong random strings for production (e.g., using: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# CORS Configuration
# For development: *
# For production: https://yourdomain.com
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
